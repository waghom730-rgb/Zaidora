# Copy to .env (which git ignores) and fill in your own values. Never commit real credentials.
# MongoDB Atlas: Database → Connect → Drivers. URL-encode special characters in the password (@ → %40).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=zaikora
MONGODB_DB=zaikora
PORT=8787
